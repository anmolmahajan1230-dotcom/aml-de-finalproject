{
	"name": "DF_Silver_Transform",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_CSV_Source",
						"type": "DatasetReference"
					},
					"name": "BronzeSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_CSV_Sink",
						"type": "DatasetReference"
					},
					"name": "SilverSink"
				}
			],
			"transformations": [
				{
					"name": "RenameColumns"
				},
				{
					"name": "AddFeatures"
				},
				{
					"name": "FilterValidRecords"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> BronzeSource",
				"BronzeSource select(skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumns",
				"RenameColumns derive({_silver_ts} = currentTimestamp()) ~> AddFeatures",
				"AddFeatures filter(!isNull(`Amount Paid`) && !isNull(`From Bank`) && !isNull(`To Bank`) && toDouble(`Amount Paid`) > 0) ~> FilterValidRecords",
				"FilterValidRecords sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SilverSink"
			]
		}
	}
}