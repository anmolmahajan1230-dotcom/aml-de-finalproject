{
	"name": "DF_Silver_Transform",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DS_Bronze_CSV_Source",
						"type": "DatasetReference"
					},
					"name": "BronzeSource"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "RenameColumns"
				},
				{
					"name": "AddFeatures"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> source1",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> BronzeSource",
				"BronzeSource select(skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumns",
				"RenameColumns derive({_silver_ts} = currentTimestamp()) ~> AddFeatures"
			]
		}
	}
}