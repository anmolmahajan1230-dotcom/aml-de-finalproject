{
	"name": "PL_01_Bronze_Ingest",
	"properties": {
		"activities": [
			{
				"name": "Copy_csv_to_parquet",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "_ingest_ts",
								"value": "@utcNow()"
							},
							{
								"name": "_source_file",
								"value": "@pipeline().parameters.p_file_name"
							},
							{
								"name": "_pipeline_run",
								"value": "@pipeline().RunId"
							},
							{
								"name": "_batch_id",
								"value": "@concat(pipeline().parameters.p_run_date, '-', pipeline().parameters.p_file_name)"
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Bronze_CSV_Source",
						"type": "DatasetReference",
						"parameters": {
							"p_file_name": "@pipeline().parameters.p_file_name"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Bronze_CSV_Sink",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"p_file_name": {
				"type": "string",
				"defaultValue": "HI-Small_Trans.csv"
			},
			"p_run_date": {
				"type": "string",
				"defaultValue": "2025-05-14"
			}
		},
		"annotations": []
	}
}