{
	"name": "PL_01_Bronze_Ingest",
	"properties": {
		"activities": [
			{
				"name": "Copy_csv_to_parquet",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "_ingest_ts",
								"value": "@utcNow()"
							},
							{
								"name": "_source_file",
								"value": "@pipeline().parameters.p_file_name"
							},
							{
								"name": "_pipeline_run",
								"value": "@pipeline().RunId"
							},
							{
								"name": "_batch_id",
								"value": "@concat(pipeline().parameters.p_run_date, '-', pipeline().parameters.p_file_name)"
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "Timestamp",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "transaction_timestamp",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "From Bank",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "from_bank",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Account2",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "from_account",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "To Bank",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "to_bank",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Account4",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "to_account ",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Amount Received",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "amount_received",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Receiving Currency",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "receiving_currency",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Amount Paid",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "amount_paid",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Payment Currency",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "payment_currency",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Payment Format",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "payment_format",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "Is Laundering",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "is_laundering",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "_ingest_ts",
									"type": "String"
								},
								"sink": {
									"name": "_ingest_ts",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "_source_file",
									"type": "String"
								},
								"sink": {
									"name": "_source_file",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "_pipeline_run",
									"type": "String"
								},
								"sink": {
									"name": "_pipeline_run",
									"type": "String",
									"physicalType": "UTF8"
								}
							},
							{
								"source": {
									"name": "_batch_id",
									"type": "String"
								},
								"sink": {
									"name": "_batch_id",
									"type": "String",
									"physicalType": "UTF8"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Bronze_CSV_Source",
						"type": "DatasetReference",
						"parameters": {
							"p_file_name": "@pipeline().parameters.p_file_name"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Bronze_Parquet_Sink",
						"type": "DatasetReference",
						"parameters": {
							"p_file_name": "@pipeline().parameters.p_file_name"
						}
					}
				]
			}
		],
		"parameters": {
			"p_file_name": {
				"type": "string",
				"defaultValue": "HI-Small_Trans.csv"
			},
			"p_run_date": {
				"type": "string",
				"defaultValue": "2025-05-14"
			}
		},
		"annotations": []
	}
}